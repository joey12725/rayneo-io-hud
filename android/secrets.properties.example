# Optional. Copy to android/secrets.properties for private builds; never commit secrets.properties.
# A plain `./gradlew assembleDebug` needs none of this: the app starts in demo/onboarding mode and you
# enter the gateway address and access token on the phone's Settings page (the token is stored encrypted).

# Default gateway base URL shown in Settings, e.g. https://gateway.example.com/glasses/v1
GATEWAY_URL=
# Only compiled into the APK when you build with -PembedToken=true (private builds only:
# anyone with the APK can extract it).
GATEWAY_TOKEN=

# Gradle properties (pass with -P, not in this file):
#   -PappId=com.example.hud   applicationId (default io.github.rayneohud.companion); tools/glassesctl.py reads APP_ID
#   -PembedToken=true         bake GATEWAY_TOKEN into BuildConfig
#   -PrequireGateway          fail assemble/install when GATEWAY_URL is missing
