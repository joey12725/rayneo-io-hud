# RayNeo iO HUD gateway: every setting as an environment variable (all optional).
# gateway.config.json (GATEWAY_CONFIG) can set the same keys and is merged over these. Generated by tools/config-examples.mjs.
# Secrets are never set here by value in config; the gateway reads them BY NAME from the secrets provider
# (GATEWAY_SECRETS=env: an env var of that name, or NAME_FILE pointing at a file).

# GATEWAY_CONFIG=./gateway.config.json


#
# port: HTTP port. A set PORT wins over the config file. Default: 8080.
# PORT=8080

#
# host: Listen address. A set HOST wins over the config file. Default: 0.0.0.0.
# HOST=0.0.0.0

#
# publicUrl: Public base URL of this gateway as the phone reaches it, e.g. https://gateway.example.com. Used for links the gateway hands out (audiobook streams). Empty: derived from the request.
# GATEWAY_PUBLIC_URL=https://gateway.example.com

#
# basePath: Path prefix the gateway is served under behind a reverse proxy, e.g. /gateway. A leading /api is always accepted too.
# GATEWAY_BASE_PATH=

#
# dataDir: Directory for gateway state (JSON collections, queued audio). Default: <gateway>/.data. A set GATEWAY_DATA wins over the config file.
# GATEWAY_DATA=

#
# modules: API modules to load (glasses, tv). Empty: all.
# GATEWAY_MODULES=

#
# accessLog: Log one line per request (method, path, status, time; never bodies). Default: false.
# GATEWAY_ACCESS_LOG=false

#
# worker: Run the background workers in this process (recording uploads, Beeper push, T3 notifications). Exactly one gateway process should. A set GATEWAY_WORKER wins over the config file. Default: false.
# GATEWAY_WORKER=false

#
# clients: Map of token SECRET NAME -> scopes. A bearer token is accepted for a scope when it equals the value of one of these secrets. glasses = the phone app, glasses.agent = the assistant (Hermes), tv = the TV launcher. Default: {"GLASSES_API_TOKEN":["glasses"],"GLASSES_AGENT_TOKEN":["glasses.agent"],"TV_LAUNCHER_TOKEN":["tv"]}.
# GATEWAY_CLIENTS={"GLASSES_API_TOKEN":["glasses"],"GLASSES_AGENT_TOKEN":["glasses.agent"],"TV_LAUNCHER_TOKEN":["tv"]}

#
# units: imperial (°F, lb) or metric (°C, kg) for the weather card and weight. Default: imperial.
# GATEWAY_UNITS=metric

#
# tz: IANA time zone for dates shown on the glasses (falls back to TZ, then UTC). Default: UTC.
# GATEWAY_TZ=Europe/Berlin

# ---- home
# home.lat: Latitude.
# GATEWAY_HOME_LAT=52.52
# home.lon: Longitude.
# GATEWAY_HOME_LON=13.405

# ---- owner
# owner.name: Display name of the owner, as prompts should call them. Default: the user.
# GATEWAY_OWNER_NAME=Sam
# owner.aliases: Other names and handles the owner goes by (case-insensitive), e.g. a nickname or chat handle.
# GATEWAY_OWNER_ALIASES=sam,sammy

# ---- assistant
# assistant.name: Name of the assistant (the Hermes agent) shown on the glasses and used in prompts. Default: Hermes.
# GATEWAY_ASSISTANT_NAME=Hermes
# assistant.workerName: Name of the background notification classifier persona used in its prompts. Default: Triage.
# GATEWAY_WORKER_NAME=Triage

# ---- secrets
# secrets.provider: env (environment variable NAME or file NAME_FILE), file (JSON at secrets.file) or infisical. Default: env.
# GATEWAY_SECRETS=env
# secrets.file: JSON file of {"NAME": "value"} for the file provider.
# GATEWAY_SECRETS_FILE=
# secrets.allow: If set, only these secret names can be read (required for infisical).
# GATEWAY_SECRET_ALLOW=
# secrets.writable: Secret names the gateway may write back (rotating OAuth refresh tokens).
# GATEWAY_SECRET_WRITABLE=
# secrets.ttlMs: How long a secret value is cached. Default: 300000.
# GATEWAY_SECRET_TTL_MS=300000
# secrets.infisicalEnvFile: Optional env-style file with INFISICAL_* keys (the INFISICAL_* environment variables win).
# INFISICAL_ENV_FILE=

# ---- llm
# llm.baseUrl: Base URL ending in /v1. Default: https://api.openai.com/v1.
# LLM_BASE_URL=https://api.openai.com/v1
# llm.apiKeySecret: Name of the secret holding the API key. Default: LLM_API_KEY.
# LLM_API_KEY_SECRET=LLM_API_KEY

# ---- models
# models.transcribe: Speech to text (dictation, memos, recordings). Default: whisper-1.
# MODEL_TRANSCRIBE=whisper-1
# models.cleanup: Dictation cleanup. Default: gpt-4o-mini.
# MODEL_CLEANUP=gpt-4o-mini
# models.fast: Fast general model (spam checks, small tasks). Default: gpt-4o-mini.
# MODEL_FAST=gpt-4o-mini
# models.smart: Stronger model (titles, morning report). Default: gpt-4o.
# MODEL_SMART=gpt-4o
# models.classifier: Notification classifier. Empty: models.fast.
# MODEL_CLASSIFIER=

# ---- hermes
# hermes.enabled: Switch the integration off entirely (its routes answer 503). Default: true.
# HERMES_ENABLED=true
# hermes.url: Hermes API server base URL. Default: http://localhost:8642.
# HERMES_URL=http://localhost:8642
# hermes.apiKeySecret: Secret holding the Hermes API server key. Default: HERMES_API_SERVER_KEY.
# HERMES_API_KEY_SECRET=HERMES_API_SERVER_KEY
# hermes.callUrl: WebSocket URL of a Hermes voice-call endpoint (ws://...). Empty: live calls are off.
# HERMES_CALL_URL=ws://hermes:8642/v1/voice/call
# hermes.callDevice: Device id the gateway sends to the voice endpoint. Default: glasses.
# HERMES_CALL_DEVICE=glasses
# hermes.callDeviceHeader: Header that carries hermes.callDevice to the voice endpoint (a voice plugin written for an older header name can set it here). Default: X-Assistant-Device.
# HERMES_CALL_DEVICE_HEADER=X-Assistant-Device
# hermes.callTokenSecret: Secret holding the bearer token for the voice endpoint. Default: HERMES_CALL_TOKEN.
# HERMES_CALL_TOKEN_SECRET=HERMES_CALL_TOKEN
# hermes.callMaxMs: Runaway cap for one call in ms (default 4 h); 0 disables it.
# HERMES_CALL_MAX_MS=
# hermes.liveContext: Send the live glasses state (screen, media, call) with every chat turn. Default: true.
# HERMES_LIVE_CONTEXT=true
# hermes.glassesContext: Replaces the context line prefixed to every glasses chat message. {{owner}} and {{assistant}} are filled in.
# HERMES_GLASSES_CONTEXT=

# ---- beeper
# beeper.enabled: Switch the integration off entirely (its routes answer 503). Default: true.
# BEEPER_ENABLED=true
# beeper.url: Beeper Desktop API base URL. Default: http://localhost:23373.
# BEEPER_URL=http://localhost:23373
# beeper.tokenSecret: Secret holding the Beeper Desktop API token. Default: BEEPER_ACCESS_TOKEN.
# BEEPER_TOKEN_SECRET=BEEPER_ACCESS_TOKEN
# beeper.live: Hold the Beeper push WebSocket open (worker only). Default: true.
# BEEPER_LIVE=true
# beeper.spam: Classify new chats for spam in the background (worker only). Default: true.
# BEEPER_SPAM=true
# beeper.spamThreshold: Confidence a spam verdict needs to take effect. Default: 0.9.
# BEEPER_SPAM_THRESHOLD=0.9
# beeper.mentions: pill (Matrix pill links where supported) or plain (@Name). Default: pill.
# BEEPER_MENTIONS=pill

# ---- t3
# t3.enabled: Switch the integration off entirely (its routes answer 503). Default: true.
# T3_ENABLED=true
# t3.machinesFile: machines.json listing T3 Code servers (see t3-machines.example.json). Default: <dataDir>/t3-machines.json.
# T3_MACHINES_FILE=./t3-machines.json
# t3.machineUrls: Overrides per machine: alias=url,alias=url.
# T3_MACHINE_URLS=
# t3.tailnetProxy: SOCKS5/HTTP proxy for *.ts.net machines, e.g. socks5h://tailscale:1055.
# T3_TAILNET_PROXY=
# t3.machineProxies: Per machine proxy overrides: alias=url or alias=direct.
# T3_MACHINE_PROXIES=
# t3.notify: Gateway-owned T3 notifications (worker only). Default: true.
# T3_NOTIFY=true
# t3.notifyNeedsAll: Default for "notify for every thread that needs me". Default: true.
# T3_NOTIFY_NEEDS_ALL=true
# t3.notifyEveryMs: Polling interval (min 5000). Default: 20000.
# T3_NOTIFY_EVERY_MS=20000
# t3.vocabFile: JSON {skills, models, commands, terms} merged into the dictation vocabulary for T3 prompts.
# T3_VOCAB_FILE=
# t3.glassesSuffix: Text appended to prompts sent from the glasses. Empty: a short note that the message was dictated on the glasses.
# T3_GLASSES_SUFFIX=

# ---- notify
# notify.policyFile: Notification policy JSON (see apis/glasses/notify-policy.default.json). Empty: the default policy.
# NOTIFY_POLICY_FILE=
# notify.promptFile: Replaces the classifier prompt (prompts/notify-route.md); {{owner}}, {{assistant}} and {{worker}} are filled in.
# NOTIFY_PROMPT_FILE=
# notify.standard: The owner's own words on what deserves an interruption; added to the classifier prompt.
# NOTIFY_STANDARD=
# notify.ownChats: Lower-case substrings of Beeper chat names that are the owner's own spaces (never promotions).
# NOTIFY_OWN_CHATS=my bots,family
# notify.timeoutMs: Classifier time budget. Default: 4000.
# NOTIFY_TIMEOUT_MS=4000

# ---- cleanup
# cleanup.guard: Dictation cleanup output check: enforce, log or off. Default: enforce.
# CLEANUP_GUARD=enforce
# cleanup.promptFile: Replaces the generic cleanup prompt (prompts/cleanup.md).
# CLEANUP_PROMPT_FILE=
# cleanup.vocabFile: JSON {terms: [...], corrections: {"heard": "meant"}} appended to the cleanup prompt.
# CLEANUP_VOCAB_FILE=

# ---- homeAssistant
# homeAssistant.enabled: Switch the integration off entirely (its routes answer 503). Default: true.
# HOMEASSISTANT_ENABLED=true
# homeAssistant.scenes: Scene buttons: [{id, name, icon, entity}] (entity: a script.* or scene.*).
# HOMEASSISTANT_SCENES=[{"id":"movie","name":"Movie time","icon":"bulb","entity":"scene.movie_time"}]
# homeAssistant.alarm: Optional alarm card: {time: sensor, mode: select, times: {"7:00 AM": script}, styles: [..]}.
# HOMEASSISTANT_ALARM={"time":"sensor.wake_time","mode":"select.alarm_mode","times":{"7:00 AM":"script.alarm_early","8:30 AM":"script.alarm_late"},"styles":["Gentle","Loud"]}
# homeAssistant.printers: 3D printer cards: [{id, name, progress, state, online, entityPrefix}].
# HOMEASSISTANT_PRINTERS=[{"id":"printer","name":"3D printer","progress":"sensor.printer_progress","state":"sensor.printer_print_state","online":"binary_sensor.printer_online","entityPrefix":"sensor.printer_"}]

# ---- people
# people.file: people.json: enrolled voices and notes for the People screen (see people.example.json). Empty or missing: People is off.
# PEOPLE_FILE=./people.json

# ---- conversations
# conversations.transcribe: Transcribe recordings with models.transcribe before delivery. Default: true.
# CONVERSATIONS_TRANSCRIBE=true
# conversations.maxAudioMb: Largest accepted recording. Default: 95.
# CONVERSATIONS_MAX_AUDIO_MB=95
# conversations.maxPending: Recordings that may wait for delivery before the phone is told to hold off. Default: 500.
# CONVERSATIONS_MAX_PENDING=500
# conversations.maxAttempts: Delivery attempts per target before it is marked failed. Default: 8.
# CONVERSATIONS_MAX_ATTEMPTS=8

#
# targets: Delivery targets: [{id, name, kind: directory|webhook|hermes|<registered>, ...}]. Default: one directory target "local" under <dataDir>/recordings.
# GATEWAY_TARGETS=[{"id":"local","name":"Recordings folder","kind":"directory","path":"./recordings"},{"id":"notes","name":"Notes webhook","kind":"webhook","url":"https://notes.example.com/hooks/glasses","auth":{"type":"hmac","secret":"NOTES_WEBHOOK_SECRET"},"audio":"multipart","retries":3,"backoffMs":2000},{"id":"assistant","name":"Hermes","kind":"hermes"}]

#
# routes: Which targets get what: {memo: [ids], ambient: [ids], dictation: [ids]}. Default: memo and ambient to every target.
# GATEWAY_ROUTES={"memo":["local","assistant"],"ambient":["local"],"dictation":[]}

# ---- report
# report.sourceDir: Directory of YYYY-MM-DD/report.md morning reports (or a morning-report.json). Empty: the report screen is empty.
# REPORT_SOURCE_DIR=

# ---- youtube
# youtube.file: JSON list of videos [{video_id, title, channel_name, duration_seconds}] shown as a curated list. Empty: off.
# YOUTUBE_LIST_FILE=
# youtube.listKey: List key. Default: picks.
# YOUTUBE_LIST_KEY=picks
# youtube.listName: List name shown on the glasses. Default: Picks.
# YOUTUBE_LIST_NAME=Picks

# ---- spotify
# spotify.discoverWeeklyUri: Your Discover Weekly playlist URI (optional).
# SPOTIFY_DISCOVER_WEEKLY_URI=
# spotify.userId: Spotify user id (optional).
# SPOTIFY_USER_ID=
# spotify.coldStart: Where playback starts when nothing is active: phone or off. Default: phone.
# SPOTIFY_COLD_START=phone

# ---- composio
# composio.calendarAccount: Composio connected-account id for Google Calendar. Empty: calendar is off.
# COMPOSIO_CALENDAR_ACCOUNT=
# composio.spotifyAccount: Composio connected-account id for Spotify.
# COMPOSIO_SPOTIFY_ACCOUNT=

# ---- abs
# abs.url: Audiobookshelf base URL (token: secret AUDIOBOOKSHELF_TOKEN). Empty: audiobooks are off.
# ABS_URL=

# ---- tv
# tv.jamLinkEntity: Home Assistant input_text.* holding a Spotify Jam link to share (optional).
# TV_JAM_LINK_ENTITY=
# tv.room: Default room name in shared messages. Default: living room.
# TV_ROOM=living room

# ---- secrets read by name (env provider). Set only the ones for integrations you use.
# GLASSES_API_TOKEN=<long random string the phone app sends>
# GLASSES_AGENT_TOKEN=<long random string Hermes sends (MCP, /assistant/*, /notify/hermes)>
# TV_LAUNCHER_TOKEN=
# LLM_API_KEY=
# HERMES_API_SERVER_KEY=
# HERMES_CALL_TOKEN=
# BEEPER_ACCESS_TOKEN=
# HOMEASSISTANT_URL=http://homeassistant.local:8123
# HOMEASSISTANT_TOKEN=
# COMPOSIO_MCP_URL=
# COMPOSIO_MCP_TOKEN=
# AUDIOBOOKSHELF_TOKEN=
# OURA_ACCESS_TOKEN=
# WEIGHTGURUS_EMAIL=
# WEIGHTGURUS_PASSWORD=
# NOTES_WEBHOOK_SECRET=
# T3 machine tokens: the secret names listed in t3-machines.json, e.g. T3_DESKTOP_TOKEN=

# ---- infisical provider (GATEWAY_SECRETS=infisical)
# INFISICAL_URL=https://app.infisical.com
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=prod
# INFISICAL_PATHS=/
