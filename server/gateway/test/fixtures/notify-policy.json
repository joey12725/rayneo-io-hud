{
  "about": "The notification policy table. Read by server/gateway/test/notify-route.test.mjs (lib/notify-policy.mjs) and by the phone's mirror test (android NotificationRoutingTest.kt / data/NotificationRules.kt) so the two rule tables cannot drift. The cases run with the default policy (apis/glasses/notify-policy.default.json) plus `policy` below merged over it, and with the owner below. expect null = semantic case (the model decides); fallback = the answer when the model is unavailable (never popup). gatewayOnly cases need facts only the gateway has.",
  "owner": {
    "name": "Robin",
    "aliases": [
      "robin",
      "rob"
    ]
  },
  "policy": {
    "dating": {
      "enabled": true
    }
  },
  "watched": [
    "mac:t1"
  ],
  "watchedTitles": {
    "mac:t1": "Fix the login flow"
  },
  "datingChannelsAbout": "Channels Tinder and Feeld register. A neutral notification (title Riley, body Hey) on each must get this reason; text = no channel rule, so the text rules (here: none match, semantic) decide.",
  "datingChannels": {
    "com.tinder": {
      "MATCHES": "dating.match",
      "NEW_LIKES": "dating.like",
      "SUPER_LIKES": "dating.like",
      "MESSAGES": "dating.message",
      "MESSAGE_LIKES": "dating.channel",
      "TOP_PICKS": "dating.channel",
      "UNCATEGORIZED": "text"
    },
    "co.feeld": {
      "new-match": "dating.match",
      "chat-messages": "dating.message",
      "PROACTIVE_MESSAGING_NOTIFICATION_CHANNEL_ID": "dating.channel",
      "com_appboy_default_notification_channel": "text",
      "fcm_fallback_notification_channel": "text"
    }
  },
